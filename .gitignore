!assets/sfx/

# But DO keep the static fallback folders (and their placeholder files)
!assets/music/.gitkeep
!assets/sfx/.gitkeep

# Node
remotion/node_modules/

# Local environment
.env
venv/
__pycache__/
*.pyc

